# Pflicht: Anthropic API-Key für die Bewerbungs-Generierung
ANTHROPIC_API_KEY=

# Optional: Passwort, um /, /profile und die Generierung zu schützen.
# Digitale Bewerbungsseiten (/a/...) und Downloads bleiben davon unberührt (bewusst öffentlich für HR).
APP_PASSWORD=

# Optional: anderes Claude-Modell verwenden
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: Speicherort für die Datenbank-Datei (z.B. Pfad eines Railway-Volumes)
DATA_DIR=./data

PORT=3000
